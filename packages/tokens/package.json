{
  "name": "@orange/tokens",
  "version": "0.1.0",
  "description": "Design tokens do Orange Design System (cores, tipografia, espaçamento, movimento).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contrast": {
      "types": "./src/contrast.ts",
      "default": "./src/contrast.ts"
    },
    "./tokens.css": "./css/tokens.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./contrast": {
        "types": "./dist/contrast.d.ts",
        "default": "./dist/contrast.js"
      },
      "./tokens.css": "./css/tokens.css"
    }
  },
  "files": [
    "dist",
    "css",
    "src"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
