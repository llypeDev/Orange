{
  "name": "@orange/tokens",
  "version": "0.3.0",
  "description": "Design tokens do Orange Design System (cores, tipografia, espaçamento, movimento e visualização de dados) em TypeScript e CSS custom properties.",
  "keywords": [
    "design-tokens",
    "tokens",
    "css-variables",
    "css-custom-properties",
    "design-system",
    "theme",
    "dark-mode",
    "accessibility",
    "orange"
  ],
  "homepage": "https://orange.llypedev.com.br",
  "bugs": {
    "url": "https://github.com/llypeDev/Orange/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llypeDev/Orange.git",
    "directory": "packages/tokens"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contrast": {
      "types": "./src/contrast.ts",
      "default": "./src/contrast.ts"
    },
    "./tokens.css": "./css/tokens.css",
    "./package.json": "./package.json",
    "./dtcg": {
      "types": "./src/dtcg.ts",
      "default": "./src/dtcg.ts"
    },
    "./tokens.dtcg.json": "./dist/tokens.dtcg.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./contrast": {
        "types": "./dist/contrast.d.ts",
        "default": "./dist/contrast.js"
      },
      "./tokens.css": "./css/tokens.css",
      "./package.json": "./package.json",
      "./dtcg": {
        "types": "./dist/dtcg.d.ts",
        "default": "./dist/dtcg.js"
      },
      "./tokens.dtcg.json": "./dist/tokens.dtcg.json"
    }
  },
  "files": [
    "dist",
    "css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "figma:sync": "tsx scripts/figma-sync.ts"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
