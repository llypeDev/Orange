{
  "name": "@orangesys/ui",
  "version": "0.5.0",
  "description": "Componentes React acessíveis (WCAG 2.2 AA) do Orange Design System: temas claro e escuro, PT/EN, hooks e ícones.",
  "keywords": [
    "react",
    "react-components",
    "design-system",
    "ui",
    "components",
    "accessibility",
    "a11y",
    "wcag",
    "dark-mode",
    "orange"
  ],
  "homepage": "https://orange.llypedev.com.br",
  "bugs": {
    "url": "https://github.com/llypeDev/Orange/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llypeDev/Orange.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/orange-ui.cjs",
    "module": "./dist/orange-ui.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/orange-ui.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/orange-ui.cjs"
        }
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/bundle-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.6",
    "@orangesys/tokens": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "^9.1.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^4.67.4",
    "rollup-plugin-dts": "^6.5.1",
    "storybook": "^9.1.10",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
