{
  "name": "orange-design-system",
  "private": true,
  "version": "0.1.0",
  "description": "Orange — design system open source, acessível e customizável.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @orangesys/docs dev",
    "storybook": "pnpm --filter @orangesys/storybook dev",
    "gen": "node scripts/gen-index.mjs",
    "build:tokens": "pnpm --filter @orangesys/tokens build",
    "build:lib": "pnpm build:tokens && pnpm --filter @orangesys/ui build",
    "build:storybook": "pnpm --filter @orangesys/storybook build",
    "build:docs": "pnpm --filter @orangesys/docs build",
    "build": "pnpm gen && pnpm build:lib && pnpm build:storybook && pnpm build:docs && node scripts/merge-storybook.mjs",
    "preview": "pnpm --filter @orangesys/docs preview",
    "test": "pnpm gen && pnpm -r --if-present test",
    "size": "node scripts/size-check.mjs",
    "test:layout": "playwright test -c tests/layout",
    "test:visual": "playwright test -c tests/visual",
    "test:visual:update": "playwright test -c tests/visual --update-snapshots",
    "typecheck": "pnpm gen && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm gen && pnpm build:lib && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
